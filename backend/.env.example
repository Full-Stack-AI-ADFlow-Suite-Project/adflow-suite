# Copia questo file in .env e metti i tuoi valori. Il file .env non va mai in git.

# Database (PostgreSQL 16)
DATABASE_URL=postgresql+psycopg://utente:password@localhost:5432/adflow
DATABASE_URL_TEST=postgresql+psycopg://utente:password@localhost:5432/adflow_test

# Archivio delle foto
ARCHIVIO_FOTO_DIR=./archivio_foto
# Dimensione massima di una richiesta HTTP, in byte: oltre, 413 (12 MiB)
RICHIESTA_MAX_BYTE=12582912

# AI: finto (sviluppo e test) oppure litellm
AI_PROVIDER=finto
AI_MODELLO_VISIONE=openrouter/openai/gpt-4o
AI_MODELLO_TESTO=openrouter/openai/gpt-4o
AI_MODELLO_IMMAGINI=openrouter/openai/gpt-5-image-mini
OPENROUTER_API_KEY=chiave-finta
OPENAI_API_KEY=chiave-finta
# Con AI_PROVIDER=litellm: dollari per milione di token e per immagine creata,
# solo se LiteLLM non conosce il prezzo del modello (0 = sconosciuto, costo
# registrato a 0). Con i modelli openrouter/ LiteLLM non li conosce mai: questi
# prezzi devono essere quelli del modello scelto, o il costo AI risulta sbagliato
AI_PREZZO_INGRESSO_MILIONE=2.50
AI_PREZZO_USCITA_MILIONE=10.00
AI_PREZZO_IMMAGINE=0.04

# Regole sui tempi
ANTICIPO_MINIMO_GIORNI=3
MARGINE_SLOT_MINUTI=15
# Solo per le prove a mano: manda avanti l'orologio di API e worker (0 = ora vera).
# Si riavviano entrambi dopo averlo cambiato; in produzione deve restare 0.
OROLOGIO_GIORNI_AVANTI=0

# Email (Mailpit in locale)
SMTP_HOST=localhost
SMTP_PORT=1025

# Social: finto (sviluppo e test) oppure meta (pubblicazione reale sulla
# Pagina di prova del team, perimetro-mvp.md D1). Le META_* servono solo
# con SOCIAL_PROVIDER=meta; il token della Pagina va solo in .env, mai in git.
SOCIAL_PROVIDER=finto
META_PAGINA_ID=000000000000000
META_INSTAGRAM_ID=00000000000000000000
META_TOKEN_PAGINA=token-finto-della-pagina
META_GRAPH_VERSIONE=v26.0
# Indirizzo pubblico da cui Instagram scarica le foto (GET /foto/{id}/pubblica):
# in demo l'URL stampato dal tunnel, per esempio cloudflared (vedi README).
FOTO_URL_PUBBLICO=https://esempio-tunnel.trycloudflare.com

# Scadenza delle sessioni dopo un periodo senza uso (R-29)
SESSIONE_ARTIGIANO_GIORNI=7
SESSIONE_OPERATORE_ORE=12

# Contatto pubblico del consorzio: sostituisci i valori fittizi
CONSORZIO_NOME=Consorzio di esempio
CONSORZIO_TELEFONO=0000000000
CONSORZIO_EMAIL=consorzio@example.com

# Sicurezza accesso: AMBIENTE=produzione richiede un segreto casuale >=32 caratteri.
AMBIENTE=sviluppo
LOGIN_LIMITE_TENTATIVI=5
LOGIN_FINESTRA_SECONDI=900
LOGIN_LIMITE_SEGRETO=solo-sviluppo-cambiare-in-produzione
# Solo nei test; vietato in produzione. Il login conserva gli account storici.
EMAIL_TEST_ENVIRONMENT=false
# COOKIE_SECURE opzionale: in produzione sempre true; in sviluppo segue HTTPS.
